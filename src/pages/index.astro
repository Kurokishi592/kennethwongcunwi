---
// Landing page. The words live in src/data/*.yaml; this file only arranges them.
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import HomeTiles from '../components/HomeTiles.astro';
import Journey from '../components/Journey.astro';
import ExperienceList from '../components/ExperienceList.astro';
import { getProfile, getProjects, thumb } from '../lib/content';

const profile = await getProfile();
const featured = (await getProjects())
  .filter((p) => p.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 9999) - (b.data.featuredRank ?? 9999))
  .slice(0, 3);
---

<BaseLayout
  title={`${profile.name} | ${profile.headline}`}
  description={profile.focus ?? profile.intro}
  canonicalPath="/"
  activeNav="home"
>
  <section class="hero landing-hero">
    <div class="container hero-grid">
      <div class="hero-photo">
        <img src={thumb('/assets/images/profile.jpg')} alt={`Portrait of ${profile.name}`} fetchpriority="high" />
      </div>

      <div class="hero-copy">
        <p class="hero-prompt mono muted">kenneth@home:~$ whoami</p>
        <h1 class="hero-name">{profile.name}</h1>
        <p class="hero-headline">{profile.headline}</p>
        <p class="hero-intro muted">{profile.intro}</p>
        {profile.focus ? <p class="hero-focus">{profile.focus}</p> : null}
        {profile.availability ? <p class="motive-meta">{profile.availability}</p> : null}
      </div>
    </div>

    <div class="container">
      <HomeTiles />
    </div>
  </section>

  <section class="section" id="journey">
    <div class="container">
      <div class="section-head">
        <h2>Journey</h2>
        <p class="muted">Mechanical first, then electrical and firmware, now robot learning.</p>
      </div>
      <Journey />
    </div>
  </section>

  <section class="section" id="now">
    <div class="container">
      <div class="section-head">
        <h2>Right now</h2>
      </div>
      <ExperienceList currentOnly />
      <div class="section-foot">
        <a class="text-link" href="/about/#work-experiences">Full experience and education →</a>
      </div>
    </div>
  </section>

  <section class="section" id="featured-projects">
    <div class="container">
      <div class="section-head">
        <h2>Featured projects</h2>
      </div>
      <div class="grid cards">
        {featured.map((p) => <ProjectCard entry={p} />)}
      </div>
      <div class="section-foot">
        <a class="text-link" href="/projects/">All projects →</a>
      </div>
    </div>
  </section>
</BaseLayout>
