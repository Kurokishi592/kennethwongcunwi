---
// About page. All the words live in src/data/*.yaml; this file only arranges them.
// Header (photo, name, facts) and a sticky in-page nav, then the sections listed under `about:` in
// src/data/layout.yaml.
import BaseLayout from '../layouts/BaseLayout.astro';
import Sections from '../components/Sections.astro';
import { getProfile, thumb } from '../lib/content';
import { getSections } from '../lib/sections';

const profile = await getProfile();
const sections = await getSections('about');
---

<BaseLayout
  title={`About | ${profile.name}`}
  description={`About ${profile.name}: experience, education and tech stack.`}
  canonicalPath="/about/"
  activeNav="whoami"
>
  <section class="about-hero">
    <div class="container about-hero-grid">
      <img class="about-photo" src={thumb('/assets/images/profile-rs25.jpg')} alt={`${profile.name} at RoboSub`} fetchpriority="high" />
      <div class="about-hero-text">
        <p class="hero-prompt mono muted">kenneth@home:~$ whoami</p>
        <h1 class="hero-name">Hi, I'm Kenneth.</h1>
        <p class="hero-headline">{profile.headline}</p>
        <p class="hero-intro muted">{profile.intro}</p>
        {profile.facts.length ? (
          <dl class="facts">
            {profile.facts.map((f) => (
              <div class="fact">
                <dt class="fact-value">{f.value}</dt>
                <dd class="fact-label muted">{f.label}</dd>
              </div>
            ))}
          </dl>
        ) : null}
      </div>
    </div>
  </section>

  <nav class="page-nav" aria-label="On this page">
    <div class="container page-nav-row">
      {sections.map((s) => (
        <a href={`#${s.id}`}>{s.title}</a>
      ))}
    </div>
  </nav>

  <Sections page="about" />
</BaseLayout>
